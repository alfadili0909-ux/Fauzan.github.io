<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Portofolio Muhammad Fauzan Alfadili</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#eceef1;--surface:#fff;--ink:#1c1f24;--mute:#59616d;--line:#cfd4da;--red:#d92f24;--on-red:#fff;--soft:#f6e3e1;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#15171b;--surface:#1f2329;--ink:#eceef1;--mute:#a3abb6;--line:#353b44;--red:#ff5a4d;--on-red:#1b0806;--soft:#3a2321;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#15171b;--surface:#1f2329;--ink:#eceef1;--mute:#a3abb6;--line:#353b44;--red:#ff5a4d;--on-red:#1b0806;--soft:#3a2321;color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.6 "Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
.wrap{max-width:860px;margin:0 auto;padding:0 20px 56px}
header{display:flex;gap:20px;align-items:center;justify-content:space-between;padding:44px 0 26px}
h1{font:900 clamp(2.2rem,8vw,4.2rem)/.95 "Archivo",Impact,sans-serif;font-stretch:125%;letter-spacing:-.01em;margin:0}
.role{margin:14px 0 0;color:var(--mute);max-width:46ch}
.badge{flex:none;width:112px;height:112px;border-radius:50%;background:var(--red);object-fit:cover;display:block}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-block:2px solid var(--ink);display:flex;gap:4px;overflow-x:auto;padding:8px 0;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
button{font:inherit;color:inherit;cursor:pointer}
nav button,.chip{border:2px solid transparent;background:none;border-radius:999px;padding:6px 16px;white-space:nowrap;font-weight:600}
nav button:hover,.chip:hover{border-color:var(--line)}
nav button[aria-selected=true],.chip[aria-pressed=true]{background:var(--ink);color:var(--bg)}
button:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--red);outline-offset:2px}
.theme{margin-left:auto;border:2px solid var(--line);background:none;border-radius:999px;padding:6px 14px;font-weight:500;color:var(--mute)}
main{padding-top:30px}
section[hidden]{display:none}
section{animation:in .25s ease-out}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
h2{font:800 1.8rem/1.1 "Archivo",sans-serif;font-stretch:112%;margin:0 0 16px}
p{margin:0 0 14px;max-width:68ch}
.card{background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:18px 20px;margin-bottom:12px}
.go{background:var(--red);color:var(--on-red);border:0;border-radius:10px;padding:10px 18px;font-weight:600;margin-top:6px;text-decoration:none;display:inline-block}
details.card summary{cursor:pointer;font-weight:700;list-style:none;display:flex;justify-content:space-between;gap:12px}
details.card summary::after{content:"+";font-size:1.4rem;line-height:1;color:var(--red)}
details.card[open] summary::after{content:"\2212"}
details.card p{margin:10px 0 0;color:var(--mute)}
.meta{font-weight:400;color:var(--mute);display:block;font-size:.92rem}
.line{position:relative;display:grid;grid-template-columns:repeat(4,1fr);margin:8px 0 22px}
.line::before,.line i{content:"";position:absolute;left:12.5%;right:12.5%;top:21px;height:6px;border-radius:3px;background:var(--line)}
.line i{right:auto;width:0;background:var(--red);transition:width .4s ease}
.st{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:8px;background:none;border:0;padding:0;font-weight:600;font-size:.88rem;text-align:center}
.st b{width:48px;height:48px;border-radius:50%;border:4px solid var(--line);background:var(--surface);display:grid;place-items:center;font:800 1.1rem "Archivo",sans-serif;transition:.3s}
.st[aria-selected=true] b{background:var(--red);border-color:var(--red);color:var(--on-red);transform:scale(1.15)}
.st.done b{border-color:var(--red)}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.pill{background:var(--surface);border:2px solid var(--line);border-radius:10px;padding:6px 12px;animation:in .2s ease-out}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border-color:var(--line)}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;opacity:0;transition:.25s;pointer-events:none;z-index:20}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media (max-width:520px){.badge{width:72px;height:72px}.st{font-size:.78rem}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div>
    <h1>Muhammad Fauzan Alfadili</h1>
    <p class="role">Mahasiswa S1 Universitas Pamulang, lulusan Teknik Kendaraan Ringan Otomotif. Berminat di bidang Teknik &amp; Manufaktur.</p>
  </div>
  <img class="badge" alt="Foto Muhammad Fauzan Alfadili" src="data:image/jpeg;base64,">
</header>
<nav role="tablist" aria-label="Bagian portofolio" id="tabs"></nav>
<main id="main"></main>
</div>
<div class="toast" id="toast" role="status"></div>
<script>
var PRODI = ""; // isi program studi, mis. "Teknik Mesin"
var EMAIL = "alfadili0909@gmail.com", HP = "085124780606";
var TABS = [["profil","Profil"],["pendidikan","Pendidikan"],["magang","Magang"],["keahlian","Keahlian"],["kontak","Kontak"]];
var STATIONS = [
 ["Perakitan Komponen","Merakit komponen elektronik, memasang komponen pada PCB (Printed Circuit Board), dan melakukan soldering jika diperlukan."],
 ["Pemeriksaan Kualitas","Memeriksa hasil produksi agar tidak ada cacat fisik atau fungsional, lalu memisahkan produk yang tidak sesuai standar (NG – Not Good)."],
 ["Perawatan Mesin","Membersihkan mesin dan melakukan pengecekan ringan secara berkala agar mesin berfungsi optimal dan kerusakan bisa dicegah."],
 ["Kepatuhan K3","Mengikuti prosedur Keselamatan dan Kesehatan Kerja dengan ketat, termasuk memakai APD: gelang antistatis, masker, dan sarung tangan."]
];
var SKILLS = {
 "Teknis":["Pengoperasian mesin produksi","Pemahaman SOP & K3","Quality Control (QC)","Maintenance & troubleshooting ringan","Perakitan elektronik & soldering"],
 "Soft skill":["Komunikasi","Kerja sama tim","Ketelitian & fokus","Orientasi pada detail","Ketahanan fisik","Inisiatif & cepat belajar"],
 "Toolset":["Microsoft Office (Word, Excel, PowerPoint)","Google Workspace (Docs, Sheets, Forms)"]
};
var $ = function(s){return document.querySelector(s)};
var esc = function(t){return t.replace(/&/g,"&amp;").replace(/</g,"&lt;")};
var tabs = $("#tabs"), main = $("#main");

TABS.forEach(function(t){
  var b = document.createElement("button");
  b.role = "tab"; b.textContent = t[1]; b.dataset.id = t[0];
  b.onclick = function(){ location.hash = t[0]; show(t[0]); };
  tabs.appendChild(b);
});
var th = document.createElement("button");
th.className = "theme"; th.textContent = "Ganti tema";
th.onclick = function(){
  var d = document.documentElement, dark = d.dataset.theme ? d.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  d.dataset.theme = dark ? "light" : "dark";
};
tabs.appendChild(th);

var prodiLine = PRODI ? "Program studi " + esc(PRODI) + "." : "";
var V = {
 profil: function(){ return '<h2>Profil</h2><p>Mahasiswa S1 Universitas Pamulang (semester 1, angkatan 2026) sekaligus lulusan SMK Yastrif 2 Parung Panjang jurusan Teknik Kendaraan Ringan Otomotif.</p><p>Berpengalaman magang sebagai Operator Produksi: mengoperasikan, memantau, dan merawat mesin pabrik sesuai standar K3 dan SOP agar proses manufaktur berjalan lancar. Teliti, mudah bekerja sama, dan cepat belajar.</p><button class="go" onclick="location.hash=\'magang\';show(\'magang\')">Lihat pengalaman magang</button>'; },
 pendidikan: function(){ return '<h2>Pendidikan</h2><details class="card" open><summary><span>Universitas Pamulang<span class="meta">S1 · Semester 1 · 2026 sampai sekarang</span></span></summary><p>Sedang menempuh pendidikan Sarjana (S1) sebagai mahasiswa baru angkatan 2026. ' + prodiLine + '</p></details><details class="card"><summary><span>SMK Yastrif 2 Parung Panjang<span class="meta">Lulus 2026</span></span></summary><p>Jurusan Teknik Kendaraan Ringan Otomotif (TKRO). Dasar teknik kendaraan, disiplin kerja, dan troubleshooting ringan.</p></details>'; },
 magang: function(){ return '<h2>Magang di PT Samwon CTI</h2><p>Operator Produksi, September sampai November 2025. Tekan setiap stasiun untuk melihat tugasnya.</p><div class="line" id="line"><i id="fill"></i>' + STATIONS.map(function(s,i){return '<button class="st" role="tab" data-i="'+i+'"><b>'+(i+1)+'</b>'+s[0]+'</button>'}).join("") + '</div><div class="card" id="detail" aria-live="polite"></div>'; },
 keahlian: function(){ return '<h2>Keahlian</h2><div class="chips" id="chips"></div><div class="pills" id="pills"></div>'; },
 kontak: function(){ return '<h2>Kontak</h2><div class="card row"><span>Telepon<span class="meta">' + HP + '</span></span><a class="go" href="tel:' + HP + '">Telepon</a></div><div class="card row"><span>Email<span class="meta">' + EMAIL + '</span></span><span><a class="go" href="mailto:' + EMAIL + '">Kirim email</a> <button class="go" id="copy">Salin email</button></span></div><div class="card">Parung Panjang, Bogor</div>'; }
};

function toast(m){ var t=$("#toast"); t.textContent=m; t.classList.add("on"); setTimeout(function(){t.classList.remove("on")},2000); }
function station(i){
  document.querySelectorAll(".st").forEach(function(b,k){ b.setAttribute("aria-selected",k===i); b.classList.toggle("done",k<i); });
  $("#fill").style.width = (75*i/3) + "%";
  $("#detail").innerHTML = "<strong>" + STATIONS[i][0] + "</strong><p style='margin:8px 0 0'>" + STATIONS[i][1] + "</p>";
}
function skills(g){
  document.querySelectorAll(".chip").forEach(function(c){ c.setAttribute("aria-pressed", c.dataset.g===g); });
  var list = g==="Semua" ? [].concat.apply([],Object.keys(SKILLS).map(function(k){return SKILLS[k]})) : SKILLS[g];
  $("#pills").innerHTML = list.map(function(s){return '<span class="pill">'+esc(s)+'</span>'}).join("");
}
function show(id){
  if(!V[id]) id = "profil";
  tabs.querySelectorAll("[data-id]").forEach(function(b){ b.setAttribute("aria-selected", b.dataset.id===id); });
  main.innerHTML = "<section>" + V[id]() + "</section>";
  if(id==="magang"){ document.querySelectorAll(".st").forEach(function(b){ b.onclick=function(){station(+b.dataset.i)} }); station(0); }
  if(id==="keahlian"){
    $("#chips").innerHTML = ["Semua"].concat(Object.keys(SKILLS)).map(function(g){return '<button class="chip" data-g="'+g+'">'+g+'</button>'}).join("");
    document.querySelectorAll(".chip").forEach(function(c){ c.onclick=function(){skills(c.dataset.g)} }); skills("Semua");
  }
  if(id==="kontak"){ $("#copy").onclick=function(){
    try{ navigator.clipboard.writeText(EMAIL).then(function(){toast("Email disalin")},function(){toast("Salin manual: "+EMAIL)}); }catch(e){ toast("Salin manual: "+EMAIL); }
  }; }
}
window.addEventListener("hashchange", function(){ show(location.hash.slice(1)); });
show(location.hash.slice(1));
</script>
</body>
</html>
